TV_WEBHOOK_SECRET=replace_with_a_long_random_secret
PAPER_ACCOUNT_BALANCE=10000
RISK_PER_TRADE_PCT=1
ATR_MULTIPLIER=1.5
REWARD_RISK_RATIO=2
SCANNER_MAX_AGE_HOURS=36
# Paper trades open at the same time (A+ pick first, then leader pullbacks)
MAX_OPEN_TRADES=2
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
TRADINGBOT_ALERT_EMAIL=
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_PAPER=true
# Stocks the daily 200-stock universe is picked from:
#   SP500         S&P 500 only (default)
#   SP500_TOP200  S&P 500 + the 200 most-traded other US stocks
#   US_ALL        all liquid US-listed common stocks
UNIVERSE_SOURCE=SP500
